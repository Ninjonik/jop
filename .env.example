# MongoDB JOP Core (Interlocking & Realtime Station State)
# SPA uses same-origin /api by default. Desktop builds require a public HTTP(S)
# API origin (or derive it from ROBLOX_REDIRECT_URI). Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_ORIGIN=
# Optional separate web SPA origin for OAuth returns and CORS.
SPA_ORIGIN=
# Additional comma-separated allowed HTTP/WebSocket client origins.
CORS_ORIGINS=
# Development Vite proxy destination.
API_PROXY_TARGET=http://localhost:3000
# Signing stays outside the application env files on the VPS:
# /var/lib/jop/signing/updater.key (private), updater.key.pub (public).
# The deploy job exports TAURI_SIGNING_PRIVATE_KEY only for native bundling.
MONGODB_URI=mongodb://jop_app:replace-with-strong-password@localhost:27017/jop?authSource=jop&replicaSet=rs0
MONGODB_DB_NAME=jop

# JOP core configuration
ROBLOX_UNIVERSE_ID=1234567890
ROBLOX_API_KEY=replace-with-messaging-api-key
ROBLOX_INBOUND_SECRET=replace-with-a-long-random-shared-secret
ROBLOX_MESSAGING_TOPIC="JOPRuntime"

# Appwrite DIS Configuration (Intranet, EDD, GVD, Shifts)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.igportals.eu/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=jopis
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=jop_dis
APPWRITE_STORAGE_BUCKET_ID=dis_storage

# Roblox OAuth 2.0 Credentials (DIS Login & Group Role Check)
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/api/auth/roblox/callback
ROBLOX_GROUP_ID=
ROBLOX_API_KEY=

# LiveKit voice calling (use a TLS WebSocket endpoint in production)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Detailed station/route diagnostics (disabled by default)
JOP_RUNTIME_DEBUG=false
