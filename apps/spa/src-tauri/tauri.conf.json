{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JOP DIS",
  "version": "0.1.0",
  "identifier": "eu.igportals.jop-dis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZSSK DIS",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; media-src 'self' blob: data:; frame-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "infoPlist": "Info.plist" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["jop-dis"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMDQyMTNFMzAwMDdEOEIKUldTTGZRQXdQaUVFTHJkdWdRVTZMS0tHaW1BSVpMdXQ1dnhXVXdqSFd6TjB5VUlZSUJhT0VhOTQK",
      "endpoints": ["https://jop.igportals.eu/releases/latest.json"]
    }
  }
}
