{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "windows": ["main", "tool-*"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:webview:allow-create-webview-window",
    "deep-link:default",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
