{
  "name": "jop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/spa"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,spa \"npm run dev:api\" \"npm run dev:spa\"",
    "dev:api": "npm run dev --workspace @jop/api",
    "dev:spa": "npm run dev --workspace @jop/spa",
    "build": "npm run build --workspace @jop/api && npm run build --workspace @jop/spa",
    "start": "npm run start --workspace @jop/api",
    "desktop:dev": "npm run tauri --workspace @jop/spa -- dev",
    "desktop:build": "npm run tauri --workspace @jop/spa -- build",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dis:setup": "node --env-file=.env.local --import tsx scripts/init-appwrite.ts",
    "dis:desktop": "node --import tsx scripts/configure-desktop-platform.ts",
    "dis:secure": "node --env-file=.env.local --import tsx scripts/secure-dis-appwrite.ts",
    "test:dis": "node --import tsx --test src/lib/dis/__tests__/*.test.ts",
    "test:dis:gvd:persistence": "node --env-file=.env.local --import tsx scripts/verify-gvd-persistence.ts",
    "preview:gvd": "vite --config scripts/gvd-preview/vite.config.mjs",
    "test:i18n": "node scripts/check-i18n.mjs && node --import tsx --test src/lib/i18n/translate.test.ts",
    "test:dis:services": "node --env-file=.env.local --import tsx scripts/verify-dis-services.ts",
    "test:dis:http": "node --env-file=.env.local --import tsx scripts/verify-dis.ts",
    "preview:edd": "vite --config scripts/edd-preview/vite.config.mjs",
    "test:session-activity": "node --env-file=.env.local --import tsx scripts/verify-session-activity.ts",
    "test:dis:edd": "node --env-file=.env.local --import tsx scripts/verify-edd-persistence.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "appwrite": "^29.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^1.68.0",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "node-appwrite": "^31.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
